#!/bin/bash

# Скрипт автоматического развертывания 7 технологических стеков на CentOS 7
# Запуск: sudo bash deploy_stacks.sh

# Завершать выполнение при любой ошибке
set -e

echo "=== [1/3] Обновление системы и установка зависимостей Docker ==="
yum install -y yum-utils device-mapper-persistent-data lvm2

echo "=== [2/3] Подключение официального репозитория Docker CE и его установка ==="
yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
yum install -y docker-ce docker-ce-cli containerd.io

echo "=== [3/3] Запуск и включение Docker в автозагрузку ==="
systemctl start docker
systemctl enable docker

# Переменные путей
WEB_ROOT="/var/www/html"
FLASH_MEMORY_MOUNT="/mnt/flashmemory"

echo "=== Развертывание технологических стеков ==="

# --- СТЭК 1: Docker + Apache2 + HTML (HELLO WORLD) ---
echo "-> Настройка Стэка 1..."
mkdir -p "${WEB_ROOT}/stack1"
echo "<h1>HELLO WORLD</h1>" > "${WEB_ROOT}/stack1/index.html"
# chcon нужен для SELinux на CentOS 7, чтобы контейнер имел доступ к папке
chcon -Rt svirt_sandbox_file_t "${WEB_ROOT}/stack1" 2>/dev/null || true

docker run -d --name apache_stack1 \
  --restart always \
  -p 8081:80 \
  -v "${WEB_ROOT}/stack1:/usr/local/apache2/htdocs/:z" \
  httpd:latest

# --- СТЭК 2: Docker + Apache2 + PHP + phpinfo() ---
echo "-> Настройка Стэка 2..."
mkdir -p "${WEB_ROOT}/stack2"
echo "<?php phpinfo(); ?>" > "${WEB_ROOT}/stack2/index.php"
chcon -Rt svirt_sandbox_file_t "${WEB_ROOT}/stack2" 2>/dev/null || true

docker run -d --name apache_php_stack2 \
  --restart always \
  -p 8082:80 \
  -v "${WEB_ROOT}/stack2:/var/www/html/:z" \
  php:apache

# --- СТЭК 3: Docker + Apache2 + PHP + Wordpress ---
echo "-> Настройка Стэка 3 (WordPress)..."
docker run -d --name wordpress_db \
  --restart always \
  -e MYSQL_ROOT_PASSWORD=wp_root_password \
  -e MYSQL_DATABASE=wordpress \
  -e MYSQL_USER=wordpress \
  -e MYSQL_PASSWORD=wordpress_password \
  mysql:5.7

docker run -d --name wordpress_stack3 \
  --restart always \
  -p 8083:80 \
  --link wordpress_db:wordpress_db \
  -e WORDPRESS_DB_HOST=wordpress_db:3306 \
  -e WORDPRESS_DB_USER=wordpress \
  -e WORDPRESS_DB_PASSWORD=wordpress_password \
  -e WORDPRESS_DB_NAME=wordpress \
  wordpress:latest

# --- СТЭК 4: Docker + Grafana ---
echo "-> Настройка Стэка 4 (Grafana)..."
docker run -d --name grafana_stack4 \
  --restart always \
  -p 3000:3000 \
  grafana/grafana:latest

# --- СТЭК 5: Docker + Apache2 + PHP + osTicket ---
echo "-> Настройка Стэка 5 (osTicket)..."
docker run -d --name osticket_db \
  --restart always \
  -e MYSQL_ROOT_PASSWORD=osticket_root_pass \
  -e MYSQL_DATABASE=osticket \
  -e MYSQL_USER=osticket \
  -e MYSQL_PASSWORD=osticket_pass \
  mysql:5.7

docker run -d --name osticket_stack5 \
  --restart always \
  -p 8085:80 \
  --link osticket_db:osticket_db \
  -e MYSQL_HOST=osticket_db \
  -e MYSQL_USER=osticket \
  -e MYSQL_PASSWORD=osticket_pass \
  -e MYSQL_DB=osticket \
  osticket/osticket:latest

# --- СТЭК 6: Docker + Apache2 + PHP + Landing (index.php на flashmemory) ---
echo "-> Настройка Стэка 6 (Landing на flashmemory)..."
mkdir -p "${FLASH_MEMORY_MOUNT}"
cat << 'EOF' > "${FLASH_MEMORY_MOUNT}/index.php"
<?php
echo "<h1>Welcome to the Landing Page running from Flash Memory!</h1>";
?>
EOF
chcon -Rt svirt_sandbox_file_t "${FLASH_MEMORY_MOUNT}" 2>/dev/null || true

docker run -d --name landing_stack6 \
  --restart always \
  -p 8086:80 \
  -v "${FLASH_MEMORY_MOUNT}:/var/www/html/:z" \
  php:apache

# --- СТЭК 7: Docker + Apache2 + PHP + Joomla ---
echo "-> Настройка Стэка 7 (Joomla)..."
docker run -d --name joomla_db \
  --restart always \
  -e MYSQL_ROOT_PASSWORD=joomla_root_pass \
  -e MYSQL_DATABASE=joomla \
  -e MYSQL_USER=joomla \
  -e MYSQL_PASSWORD=joomla_pass \
  mysql:5.7

docker run -d --name joomla_stack7 \
  --restart always \
  -p 8087:80 \
  --link joomla_db:joomla_db \
  -e JOOMLA_DB_HOST=joomla_db \
  -e JOOMLA_DB_USER=joomla \
  -e JOOMLA_DB_PASSWORD=joomla_pass \
  -e JOOMLA_DB_NAME=joomla \
  joomla:latest

echo "=========================================================="
echo " ВСЕ СТЭКИ УСПЕШНО РАЗВЕРНУТЫ!"
echo " Проверить запущенные контейнеры: docker ps"
echo "=========================================================="
