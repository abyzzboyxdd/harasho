---
- name: Configure Dev/Prod Stacks via Ansible (CentOS 7)
  hosts: all
  become: yes
  vars:
    web_root: "/var/www/html"
    flash_memory_mount: "/mnt/flashmemory"
    
  tasks:
    # --- НАСТРОЙКА DOCKER НА CENTOS 7 ---
    - name: Install required system packages
      yum:
        name:
          - yum-utils
          - device-mapper-persistent-data
          - lvm2
        state: present

    - name: Add Docker CE repository
      get_url:
        url: https://download.docker.com/linux/centos/docker-ce.repo
        dest: /etc/yum.repos.d/docker-ce.repo

    - name: Install Docker CE and Python dependencies
      yum:
        name:
          - docker-ce
          - docker-ce-cli
          - containerd.io
          - python3-pip
        state: present
        update_cache: yes

    - name: Install Docker module for Python via pip
      pip:
        name: docker
        executable: pip3

    - name: Ensure Docker service is running and enabled
      service:
        name: docker
        state: started
        enabled: yes

    # --- СТЭК 1: Docker + Apache2 + HTML (HELLO WORLD) ---
    - name: Stack 1 - Create HTML Directory
      file:
        path: "{{ web_root }}/stack1"
        state: directory
        mode: '0755'

    - name: Stack 1 - Create Hello World index.html
      copy:
        content: "<h1>HELLO WORLD</h1>"
        dest: "{{ web_root }}/stack1/index.html"

    - name: Stack 1 - Run Apache Docker Container
      docker_container:
        name: apache_stack1
        image: httpd:latest
        state: started
        restart_policy: always
        ports:
          - "8081:80"
        volumes:
          - "{{ web_root }}/stack1:/usr/local/apache2/htdocs/"

    # --- СТЭК 2: Docker + Apache2 + PHP + phpinfo() ---
    - name: Stack 2 - Create PHP Directory
      file:
        path: "{{ web_root }}/stack2"
        state: directory
        mode: '0755'

    - name: Stack 2 - Create index.php with phpinfo
      copy:
        content: "<?php phpinfo(); ?>"
        dest: "{{ web_root }}/stack2/index.php"

    - name: Stack 2 - Run Apache + PHP Docker Container
      docker_container:
        name: apache_php_stack2
        image: php:apache
        state: started
        restart_policy: always
        ports:
          - "8082:80"
        volumes:
          - "{{ web_root }}/stack2:/var/www/html/"

    # --- СТЭК 3: Docker + Apache2 + PHP + Wordpress ---
    - name: Stack 3 - Run WordPress Database Container
      docker_container:
        name: wordpress_db
        image: mysql:5.7
        state: started
        restart_policy: always
        env:
          MYSQL_ROOT_PASSWORD: wp_root_password
          MYSQL_DATABASE: wordpress
          MYSQL_USER: wordpress
          MYSQL_PASSWORD: wordpress_password

    - name: Stack 3 - Run WordPress Container
      docker_container:
        name: wordpress_stack3
        image: wordpress:latest
        state: started
        restart_policy: always
        ports:
          - "8083:80"
        env:
          WORDPRESS_DB_HOST: wordpress_db:3306
          WORDPRESS_DB_USER: wordpress
          WORDPRESS_DB_PASSWORD: wordpress_password
          WORDPRESS_DB_NAME: wordpress
        links:
          - "wordpress_db:wordpress_db"

    # --- СТЭК 4: Docker + Grafana ---
    - name: Stack 4 - Run Grafana Container
      docker_container:
        name: grafana_stack4
        image: grafana/grafana:latest
        state: started
        restart_policy: always
        ports:
          - "3000:3000"

    # --- СТЭК 5: Docker + Apache2 + PHP + osTicket ---
    - name: Stack 5 - Run osTicket Database Container
      docker_container:
        name: osticket_db
        image: mysql:5.7
        state: started
        restart_policy: always
        env:
          MYSQL_ROOT_PASSWORD: osticket_root_pass
          MYSQL_DATABASE: osticket
          MYSQL_USER: osticket
          MYSQL_PASSWORD: osticket_pass

    - name: Stack 5 - Run osTicket Container
      docker_container:
        name: osticket_stack5
        image: osticket/osticket:latest
        state: started
        restart_policy: always
        ports:
          - "8085:80"
        env:
          MYSQL_HOST: osticket_db
          MYSQL_USER: osticket
          MYSQL_PASSWORD: osticket_pass
          MYSQL_DB: osticket
        links:
          - "osticket_db:osticket_db"

    # --- СТЭК 6: Docker + Apache2 + PHP + Landing (на flashmemory) ---
    - name: Stack 6 - Ensure Flash Memory Mount Point Exists
      file:
        path: "{{ flash_memory_mount }}"
        state: directory
        mode: '0755'

    - name: Stack 6 - Create Landing Page index.php on flashmemory
      copy:
        content: |
          <?php
          echo "<h1>Welcome to the Landing Page running from Flash Memory!</h1>";
          ?>
        dest: "{{ flash_memory_mount }}/index.php"

    - name: Stack 6 - Run Apache + PHP Landing Container
      docker_container:
        name: landing_stack6
        image: php:apache
        state: started
        restart_policy: always
        ports:
          - "8086:80"
        volumes:
          - "{{ flash_memory_mount }}:/var/www/html/"

    # --- СТЭК 7: Docker + Apache2 + PHP + Joomla ---
    - name: Stack 7 - Run Joomla Database Container
      docker_container:
        name: joomla_db
        image: mysql:5.7
        state: started
        restart_policy: always
        env:
          MYSQL_ROOT_PASSWORD: joomla_root_pass
          MYSQL_DATABASE: joomla
          MYSQL_USER: joomla
          MYSQL_PASSWORD: joomla_pass

    - name: Stack 7 - Run Joomla Container
      docker_container:
        name: joomla_stack7
        image: joomla:latest
        state: started
        restart_policy: always
        ports:
          - "8087:80"
        env:
          JOOMLA_DB_HOST: joomla_db
          JOOMLA_DB_USER: joomla
          JOOMLA_DB_PASSWORD: joomla_pass
          JOOMLA_DB_NAME: joomla
        links:
          - "joomla_db:joomla_db"
