#!/bin/bash

# Прерывать выполнение при ошибках
set -e

echo "=== 1. ПЕРЕКЛЮЧЕНИЕ ЗЕРКАЛ И ОБНОВЛЕНИЕ СИСТЕМЫ ==="
# Переводим базовые репозитории на архив Vault (CentOS 7 End of Life)
sed -i s/mirror.centos.org/vault.centos.org/g /etc/yum.repos.d/CentOS-*.repo
sed -i s/^#.*baseurl=http/baseurl=http/g /etc/yum.repos.d/CentOS-*.repo
sed -i s/^mirrorlist=http/#mirrorlist=http/g /etc/yum.repos.d/CentOS-*.repo

yum clean all
yum makecache
yum install -y epel-release yum-utils wget curl git unzip nano ca-certificates
update-ca-trust force-enable

echo "=== 2. УСТАНОВКА РЕПОЗИТОРИЕВ И ПАКЕТОВ (ANSIBLE, PHP 8.1, NODE 16) ==="
# Установка Ansible
yum install -y ansible

# Настройка Remi PHP 8.1
yum install -y http://rpms.remirepo.net/enterprise/remi-release-7.rpm || true
if [ -f /etc/yum.repos.d/remi-php81.repo ]; then
    sed -i '/\[remi-php81\]/,/^\[/ s/enabled=0/enabled=1/' /etc/yum.repos.d/remi-php81.repo
else
    yum-config-manager --enable remi-php81 || true
fi

# Установка PHP и модулей
yum install -y php php-cli php-fpm php-mysqlnd php-zip php-devel php-gd php-mbstring php-curl php-xml php-bcmath php-json

# Установка Node.js 16 (последняя рабочая версия для glibc на CentOS 7)
rm -f /etc/yum.repos.d/nodesource*.repo
curl -sL https://rpm.nodesource.com/setup_16.x | bash -
yum install -y nodejs

# Установка Composer и подготовка папок
curl -sS https://getcomposer.org/installer | php
mv composer.phar /usr/local/bin/composer && chmod +x /usr/local/bin/composer

mkdir -p /opt/ansible_stacks
mkdir -p /opt/stacks
mkdir -p /mnt/flashmemory

# Имитация файлов для Стека 6
echo "<?php echo '<h1>Landing Page from Flashmemory (Stack 6)</h1>'; ?>" > /mnt/flashmemory/index.php

echo "=== 3. ЗАПУСК ANSIBLE PLAYBOOK (СТЕКИ 1-7) ==="
cat << 'EOF' > /opt/ansible_stacks/playbook.yml
---
- name: Deploy Docker Stacks 1-7
  hosts: localhost
  connection: local
  tasks:
    - name: Install Docker system packages
      yum:
        name: [device-mapper-persistent-data, lvm2]
        state: present

    - name: Add Docker stable repository
      get_url:
        url: https://download.docker.com/linux/centos/docker-ce.repo
        dest: /etc/yum.repos.d/docker-ce.repo

    - name: Install Docker Engine
      yum:
        name: docker-ce
        state: present

    - name: Ensure Docker service is running
      service:
        name: docker
        state: started
        enabled: yes

    # Стек 1: Apache + HTML -> Port 8001
    - name: Stack 1 - Apache HTML Hello World
      shell: |
        docker run -d --name s1_html -p 8001:80 --restart unless-stopped \
        php:8.1-apache bash -c "echo '<h1>HELLO WORLD</h1>' > /var/www/html/index.html && apache2-foreground"
      ignore_errors: yes

    # Стек 2: Apache + PHP Info -> Port 8002
    - name: Stack 2 - Apache PHP phpinfo
      shell: |
        docker run -d --name s2_phpinfo -p 8002:80 --restart unless-stopped \
        php:8.1-apache bash -c "echo '<?php phpinfo(); ?>' > /var/www/html/index.php && apache2-foreground"
      ignore_errors: yes

    # Стек 3: Apache + PHP + Wordpress (внутри Ansible) -> Port 8003
    - name: Stack 3 - MySQL for Wordpress
      shell: docker run -d --name wp_db -e MYSQL_ROOT_PASSWORD=secret -e MYSQL_DATABASE=wp mysql:5.7
      ignore_errors: yes

    - name: Stack 3 - Wordpress Container
      shell: docker run -d --name s3_wordpress --link wp_db:mysql -p 8003:80 -e WORDPRESS_DB_PASSWORD=secret --restart unless-stopped wordpress:latest
      ignore_errors: yes

    # Стек 4: Grafana -> Port 8004
    - name: Stack 4 - Grafana Container
      shell: docker run -d --name s4_grafana -p 8004:3000 --restart unless-stopped grafana/grafana:latest
      ignore_errors: yes

  # Стек 5: osTicket -> Port 8005
- name: Ensure osTicket docker network exists
  community.docker.docker_network:
    name: osticket_net
    state: present

- name: Stack 5 - MariaDB for osTicket
  community.docker.docker_container:
    name: ost_db
    image: mariadb:10.5
    state: started
    restart_policy: unless-stopped
    networks:
      - name: osticket_net
    env:
      MYSQL_ROOT_PASSWORD: "secret"
      MYSQL_DATABASE: "osticket"

- name: Stack 5 - osTicket Container
  community.docker.docker_container:
    name: s5_osticket
    image: osticket/osticket:latest
    state: started
    restart_policy: unless-stopped
    networks:
      - name: osticket_net
    ports:
      - "8005:80"
    env:
      MYSQL_HOST: "ost_db"
      MYSQL_DATABASE: "osticket"
      MYSQL_USER: "root"
      MYSQL_PASSWORD: "secret"

    - name: Stack 5 - osTicket Container
      shell: docker run -d --name s5_osticket --link ost_db:mysql -p 8005:80 --restart unless-stopped osticket/osticket:latest
      ignore_errors: yes

    # Стек 6: Landing (flashmemory) -> Port 8006
    - name: Stack 6 - Landing from flashmemory volume
      shell: docker run -d --name s6_landing -p 8006:80 -v /mnt/flashmemory:/var/www/html --restart unless-stopped php:8.1-apache
      ignore_errors: yes

    # Стек 7: Joomla -> Port 8007
    - name: Stack 7 - MySQL for Joomla
      shell: docker run -d --name joomla_db -e MYSQL_ROOT_PASSWORD=secret -e MYSQL_DATABASE=joomla mysql:5.7
      ignore_errors: yes

    - name: Stack 7 - Joomla Container
      shell: docker run -d --name s7_joomla --link joomla_db:mysql -p 8007:80 --restart unless-stopped joomla:latest
      ignore_errors: yes
EOF

ansible-playbook /opt/ansible_stacks/playbook.yml

echo "=== 4. РАЗВЕРТЫВАНИЕ НА ТЕКСТОВОМ ЛИСТКЕ (СТЕКИ 8-10 + JS) ==="

# Стек 8: DJANGO (Порт 8001 по листку стола №1)
echo "--- Развертывание: DJANGO ---"
mkdir -p /opt/stacks/django && cd /opt/stacks/django
python3 -m venv env
source env/bin/activate
pip install --upgrade pip django
django-admin startproject testsite
cd testsite
python manage.py migrate
DJANGO_SUPERUSER_PASSWORD=adminpassword DJANGO_SUPERUSER_USERNAME=admin DJANGO_SUPERUSER_EMAIL=admin@example.com python manage.py createsuperuser --noinput || true
sed -i "s/ALLOWED_HOSTS = \[\]/ALLOWED_HOSTS = ['*']/g" testsite/settings.py
nohup python manage.py runserver 0.0.0.0:8001 > django.log 2>&1 &
deactivate

# Стек 9: LARAVEL (Порт 8081 по листку стола №1)
echo "--- Развертывание: LARAVEL ---"
cd /opt/stacks
rm -rf example
composer create-project laravel/laravel example --no-interaction
cd example
nohup php artisan serve --host=0.0.0.0 --port=8081 > laravel.log 2>&1 &

# Стек 10: YII (Порт 8881 по листку стола №1)
echo "--- Развертывание: YII ---"
cd /opt/stacks
rm -rf basic
composer create-project --prefer-dist yiisoft/yii2-app-basic basic --no-interaction
cd basic
nohup php yii serve 0.0.0.0 --port=8881 > yii.log 2>&1 &

# ДОПОЛНИТЕЛЬНО: REACT (Порт 3001 по листку стола №1)
echo "--- Развертывание: REACT ---"
cd /opt/stacks
rm -rf demo-app
npx create-react-app demo-app --use-npm
cd demo-app
nohup env PORT=3001 npm start > react.log 2>&1 &

# ДОПОЛНИТЕЛЬНО: VUE JS (Порт 5171 по листку стола №1)
echo "--- Развертывание: VUE JS ---"
cd /opt/stacks
rm -rf vue-project
npx create-vue vue-project --default
cd vue-project
npm install
nohup npm run dev -- --host 0.0.0.0 --port 5171 > vue.log 2>&1 &

echo "=== 5. НАСТРОЙКА FIREWALLD ==="
if systemctl is-active --quiet firewalld; then
    # Открываем порты для всех запущенных веб-служб (Стол 1)
    firewall-cmd --permanent --add-port={8001,8002,8003,8004,8005,8006,8007}/tcp
    firewall-cmd --permanent --add-port={8081,8881,3001,5171}/tcp
    firewall-cmd --reload
    echo "Все порты успешно открыты в брандмауэре!"
else
    echo "Firewalld выключен, порты открыты по умолчанию."
fi

echo "========================================================"
echo "   ВСЕ 10 СТЕКОВ УСПЕШНО НАСТРОЕНЫ И СВЯЗАНЫ ПО ПОРТАМ! "
echo "========================================================"
